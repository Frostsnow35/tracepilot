# TracePilot 环境变量示例
# 复制为 .env 并按需修改；docker compose 会自动读取 .env。

# ---- 数据库（docker compose db 服务用）----
POSTGRES_DB=tracepilot
POSTGRES_USER=tracepilot
POSTGRES_PASSWORD=tracepilot

# ---- 后端 ----
TRACEPILOT_DATABASE_URL=postgresql://tracepilot:tracepilot@localhost:5432/tracepilot
TRACEPILOT_ENV=dev
TRACEPILOT_APP_NAME=TracePilot
TRACEPILOT_API_KEY_HEADER=x-tracepilot-key
TRACEPILOT_INGEST_BATCH_MAX=500
TRACEPILOT_PORT=8000

# ---- 前端 ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
